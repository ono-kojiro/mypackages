[Unit]
Description=SeaweedFS S3 Server
After=seaweedfs-filer.service
Requires=seaweedfs-filer.service

[Service]
EnvironmentFile=/etc/seaweedfs/s3.env

ExecStart=/usr/bin/weed s3 ${S3_FILER_OPTION} ${S3_HTTP_PORT_OPTION} ${S3_HTTPS_PORT_OPTION} ${S3_CERT_FILE_OPTION} ${S3_KEY_FILE_OPTION} ${S3_TLSVERIFYCLIENTCERT_OPTION}

Restart=always

User=seaweedfs
Group=seaweedfs


[Install]
WantedBy=multi-user.target

