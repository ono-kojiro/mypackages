[Unit]
Description=SeaweedFS Volume Server
Requires=seaweedfs-master.service
After=seaweedfs-master.service

[Service]
Type=simple
EnvironmentFile=/etc/seaweedfs/tls.env
EnvironmentFile=/etc/seaweedfs/volume.env

ExecStart=/usr/bin/weed volume -dir ${VOLUME_DIR} -max=${VOLUME_MAX} -master=${VOLUME_MASTER}

Restart=on-failure
LimitNOFILE=100000

User=seaweedfs
Group=seaweedfs

[Install]
WantedBy=multi-user.target

