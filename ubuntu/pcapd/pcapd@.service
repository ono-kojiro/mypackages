[Unit]
Description=pcapd on %i
Requires=network.target
After=network.target

[Service]
Type=simple
#EnvironmentFile=/etc/pcapd/pcapd.conf
ExecStart=/usr/bin/pcapd -c /etc/pcapd/pcapd.conf %i
Restart=on-failure

User=root
Group=root

WorkingDirectory=/var/lib/pcapd

[Install]
WantedBy=multi-user.target

